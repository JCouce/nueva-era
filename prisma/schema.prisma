generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  MASTER
}

enum CharacterStatus {
  DRAFT
  APPROVED
}

enum EstadoCombate {
  EN_CURSO
  TERMINADO
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  passwordHash  String? // bcrypt; null cuando el user entra solo por Google
  role          Role        @default(PLAYER)
  image         String?
  emailVerified DateTime?
  characters    Character[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime    @default(now())
}

model Character {
  id               String          @id @default(cuid())
  name             String
  ownerId          String
  owner            User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stats            Json            @default("{}")
  status           CharacterStatus @default(DRAFT)
  approvedAt       DateTime?
  // Foto de atributos/habilidades en el momento de aprobar (aprobacion.ts).
  // null = nunca aprobada, o aprobada antes de que existiera este campo.
  approvedSnapshot Json?
  xp               Int             @default(0)
  creditos         Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  combatientes     Combatiente[]

  @@index([ownerId])
}

// Fase 6b (docs/fase-6b.md), subtarea 1.1. Una instancia de combate: el
// máster la crea, mete dentro Combatientes y lleva ronda/turno. Una sola
// EN_CURSO a la vez (se comprueba en el server action, no aquí — no hay
// forma limpia de expresar "unique where estado = EN_CURSO" en el schema de
// Prisma sin SQL a mano, y con un solo máster no compensa la complejidad).
//
// No vive dentro de Character.stats ni tiene ownerId: lo escribe y lo lee
// el máster, igual que xp/creditos — mismo motivo, ver docs/traspaso.md §9.
model Combate {
  id           String        @id @default(cuid())
  estado       EstadoCombate @default(EN_CURSO)
  ronda        Int           @default(1)
  // Posición dentro del orden de Combatientes (por su campo `orden`), no un
  // id — más simple que una relación con nombre propio, a cambio de que el
  // bloque 2 (consola) tenga que recalcularla al reordenar o quitar a
  // alguien. Ver la subtarea 2.3 antes de tocar esto.
  turnoIndex   Int           @default(0)
  combatientes Combatiente[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  terminadoAt  DateTime?
}

// Una fila en la cola de iniciativa de un Combate: un jugador (characterId),
// un NPC de catálogo (npcTemplateId), o un NPC ad-hoc (ni uno ni otro, solo
// `nombre` tecleado a mano) — los tres orígenes conviven porque a veces
// merece la pena tener el bicho guardado (subtarea 5.1) y a veces es un
// guardia suelto que no va a volver a salir.
//
// pgActual/pgMax/fatigaActual/fatigaMax son una FOTO al añadir al combate,
// no un valor derivado en vivo: si el personaje sube de nivel a mitad de
// sesión, el combate en curso no debe moverse solo bajo los pies de nadie.
// `estados` guarda EstadoActivo[] (lib/rules/estados.ts) como Json — mismo
// criterio que Character.stats: es la forma más barata de iterar mientras
// el catálogo de estados siga cambiando.
model Combatiente {
  id            String       @id @default(cuid())
  combateId     String
  combate       Combate      @relation(fields: [combateId], references: [id], onDelete: Cascade)
  characterId   String?
  character     Character?   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  npcTemplateId String?
  npcTemplate   NpcTemplate? @relation(fields: [npcTemplateId], references: [id], onDelete: SetNull)
  // Nombre a mostrar, copiado al añadir (del Character, del NpcTemplate, o
  // tecleado a mano para un NPC ad-hoc). Nunca se lee en vivo de ninguno de
  // los dos — mismo motivo que la foto de PG/fatiga de arriba. También es
  // lo que permite "Goblin #1, #2, #3" al clonar (subtarea 5.3): cada clon
  // es su propia fila con su propio nombre, sin tocar el NpcTemplate.
  nombre        String
  pgActual      Int
  pgMax         Int
  fatigaActual  Int
  fatigaMax     Int
  iniciativa    Int?
  // Orden de la cola de iniciativa. No se deriva solo de `iniciativa`
  // (empates, reordenar a mano con las flechas de la subtarea 2.3): es su
  // propio campo, que el máster puede mover sin tocar la iniciativa tirada.
  orden         Int          @default(0)
  estados       Json         @default("[]")
  // Bloque 6.1 (niebla sobre NPCs): el jugador ve "Enemigo A" sin nombre ni
  // PG exactos mientras esto sea true. Se añade ahora, sin UI todavía, para
  // no tener que migrar el schema otra vez cuando llegue esa pieza.
  oculto        Boolean      @default(false)
  // Sale de la cola de turnos sin borrar la fila (guarda su sitio en el
  // historial de la fase 6.5).
  derrotado     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([combateId])
  @@index([characterId])
  @@index([npcTemplateId])
}

// El catálogo de NPCs del máster (subtarea 1.2) — a diferencia de
// especies.ts/equipo.ts, esto NO es un catálogo de reglas del diseñador:
// son los monstruos y PNJs de esta mesa, así que vive en base de datos y lo
// crea/edita el máster desde la UI (subtarea 5.1), no un desarrollador
// desde el código. Deliberadamente mínimo — nombre, PG base y una nota de
// texto libre, nada de atributos/habilidades completos todavía (ver la
// nota sobre NPCs ligeros en docs/fase-6b.md, bloque "El motor de
// estados").
model NpcTemplate {
  id           String        @id @default(cuid())
  nombre       String
  pgBase       Int
  nota         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  combatientes Combatiente[]
}

// --- Modelos del adapter de Auth.js (para Google OAuth futuro) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
